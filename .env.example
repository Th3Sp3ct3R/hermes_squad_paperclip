DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# OpenRouter (LLM orchestration)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# MiniMax (B-side audio generation + Hermes voice agent TTS)
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_VOICE_ID=English_expressive_narrator

# ElevenLabs (Hermes voice identity)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=

# OpenAI (Whisper transcription for voice agent)
OPENAI_API_KEY=your-openai-key-here

# Suno (cookie-based fallback when Chrome CDP isn't available)
# Get from: suno.com DevTools → Network → any studio-api.suno.ai request → Cookie header
SUNO_COOKIE=

# Raziel research skills directory (optional — defaults to server/src/hermes/skills/research/)
RAZIEL_SKILLS_DIR=

# Hermes Control Plane (standalone service for hierarchy & permissions)
HERMES_CONTROL_PLANE_URL=http://localhost:19000
